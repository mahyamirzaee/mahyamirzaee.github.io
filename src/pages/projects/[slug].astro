---
import Project from '../../views/Project.astro';
import { projects } from '../../i18n';

export async function getStaticPaths() {
  const list = await projects('en');
  return list.filter((p) => !p.entry.data.href).map((p) => ({ params: { slug: p.slug }, props: p }));
}
const { entry, fallback } = Astro.props;
---
<Project lang="en" entry={entry} fallback={fallback} />
