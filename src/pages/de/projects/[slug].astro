---
import Project from '../../../views/Project.astro';
import { projects } from '../../../i18n';

export async function getStaticPaths() {
  const list = await projects('de');
  return list.map((p) => ({ params: { slug: p.slug }, props: p }));
}
const { entry, fallback } = Astro.props;
---
<Project lang="de" entry={entry} fallback={fallback} />
