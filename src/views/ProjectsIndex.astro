---
import Base from '../layouts/Base.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { link, page, projects, ui, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = await ui(lang);
const { entry } = await page('projects', lang);
const list = await projects(lang);
// Pictures are placed freely, three in a row, with different sizes and shapes.
// The rhythm repeats every six projects: width of the picture, its shape, and how far it sits down.
const widths  = ['28%', '40%', '25%', '28%', '30%', '25%'];
const shapes  = ['4 / 3', '5 / 4', '1 / 1', '16 / 10', '3 / 4', '4 / 3'];
const offsets = ['0rem', '3rem', '1rem', '1.5rem', '0rem', '4rem'];
---
<Base title={entry.data.title} lang={lang}>
  <h1 class="visually-hidden">{entry.data.title}</h1>
  <ul class="wall">
    {list.map((p, i) => (
      <ProjectTile
        href={p.entry.data.listHref ?? p.entry.data.href ?? link(`projects/${p.slug}`, lang)}
        data={p.entry.data}
        shape={shapes[i % 6]}
        place={`--w:${widths[i % 6]};--down:${offsets[i % 6]}`}
        wipLabel={t.workInProgress} />
    ))}
  </ul>
  {(entry.data as any).other && (import.meta.env.DEV || !(entry.data as any).otherDraft) && (
    <section class="other">
      <h2>{(entry.data as any).otherTitle}{import.meta.env.DEV && (entry.data as any).otherDraft && <span class="draft"> · draft (not online)</span>}</h2>
      <dl>
        {(entry.data as any).other.map((o: any) => (
          <div><dt>{o.name}</dt><dd>{o.text}{o.website && <> <a href={o.website} rel="noopener">{(entry.data as any).websiteLink} ↗</a></>}</dd></div>
        ))}
      </dl>
    </section>
  )}
</Base>
<style>
  /* the heading stays for screen readers and search engines, but is not shown */
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* Pictures side by side, three per row, with free sizes and small vertical shifts */
  .wall {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start;
    row-gap: 4.5rem;
  }
  .wall :global(.slot) { width: var(--w); margin-top: var(--down); }
  @media (max-width: 52rem) {
    .wall { row-gap: 3rem; }
    .wall :global(.slot) { width: 47%; margin-top: 0; }
  }
  @media (max-width: 32rem) {
    .wall :global(.slot) { width: 100%; }
  }
  .other { margin-top: 6rem; border-top: 1px solid var(--line); padding-top: 2.5rem; }
  .other h2 { margin-top: 0; font-size: 1.4rem; }
  .draft { font-family: var(--font-text); font-size: 0.8rem; color: #b3541e; }
  .other dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 3.5rem; margin: 0; }
  .other dt { font-family: var(--font-head); font-size: 1.1rem; margin-bottom: 0.3rem; }
  .other dd { margin: 0; color: var(--muted); }
  @media (max-width: 44rem) { .other dl { grid-template-columns: 1fr; } }
</style>
