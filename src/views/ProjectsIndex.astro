---
import Base from '../layouts/Base.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { link, page, projects, ui, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = await ui(lang);
const { entry } = await page('projects', lang);
const list = await projects(lang);
// Card sizes repeat in this rhythm: wide, tall, small, small, half, half
const rhythm = ['wide', 'tall', 'small', 'small', 'half', 'half'];
// Frame finishes repeat like a mixed gallery wall: black, white, oak
const frames = ['black', 'white', 'oak', 'black', 'oak', 'white'];
---
<Base title={entry.data.title} lang={lang}>
  <h1>{entry.data.title}</h1>
  <ul class="bento">
    {list.map((p, i) => (
      <ProjectTile
        href={p.entry.data.href ?? link(`projects/${p.slug}`, lang)}
        data={p.entry.data}
        size={rhythm[i % rhythm.length]}
        frame={frames[i % frames.length]}
        wipLabel={t.workInProgress} />
    ))}
  </ul>
  {(entry.data as any).other && (
    <section class="other">
      <h2>{(entry.data as any).otherTitle}</h2>
      <dl>
        {(entry.data as any).other.map((o: any) => (
          <div><dt>{o.name}</dt><dd>{o.text}{o.website && <> <a href={o.website} rel="noopener">{(entry.data as any).websiteLink} ↗</a></>}</dd></div>
        ))}
      </dl>
    </section>
  )}
</Base>
<style>
  /* Card grid: 6 columns; card sizes come from the rhythm above */
  .bento {
    list-style: none; padding: 0; margin: 2.5rem 0 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: auto; grid-auto-flow: dense; gap: 3rem 2.5rem;
  }
  .bento :global(.wide)  { grid-column: span 4; }
  .bento :global(.tall)  { grid-column: span 2; grid-row: span 2; }
  .bento :global(.small) { grid-column: span 2; }
  .bento :global(.half)  { grid-column: span 3; }
  @media (max-width: 62rem) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bento :global(.wide), .bento :global(.half) { grid-column: span 2; }
    .bento :global(.tall)  { grid-column: span 1; grid-row: span 2; }
    .bento :global(.small) { grid-column: span 1; }
  }
  @media (max-width: 40rem) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .bento :global(.wide), .bento :global(.half), .bento :global(.tall), .bento :global(.small) { grid-column: auto; grid-row: auto; }
  }
  .other { margin-top: 6rem; border-top: 1px solid var(--line); padding-top: 2.5rem; }
  .other h2 { margin-top: 0; font-size: 1.4rem; }
  .other dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 3.5rem; margin: 0; }
  .other dt { font-family: var(--font-head); font-size: 1.1rem; margin-bottom: 0.3rem; }
  .other dd { margin: 0; color: var(--muted); }
  @media (max-width: 44rem) { .other dl { grid-template-columns: 1fr; } }
</style>
