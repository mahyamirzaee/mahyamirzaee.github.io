---
// One project card in the Design projects grid. The whole card is clickable.
// Inside: title and a short description at the top, the cover image (or animation) below.
import Placeholder from './Placeholder.astro';
import TactCover from './TactCover.astro';
import { asset } from '../i18n';
interface Props { href: string; data: any; size: string; wipLabel: string; }
const { href, data, size, wipLabel } = Astro.props;
const external = href.startsWith('http');
---
<li class:list={['tile', size]}>
  <a class="hit" href={href} {...(external ? { rel: 'noopener' } : {})}>
    <span class="text">
      <span class="title">{data.title}{external && <span class="ext" aria-hidden="true"> ↗</span>}</span>
      <span class="short">{data.short}</span>
      {data.status && <span class="wip">{wipLabel}</span>}
    </span>
    <span class="media" aria-hidden="true">
      {data.coverAnimation === 'tact'
        ? <TactCover />
        : data.cover
          ? <img src={asset(data.cover)} alt="" loading="lazy" />
          : <Placeholder label={`image for ${data.title}`} ratio="auto" />}
    </span>
  </a>
</li>
<style>
  .tile { list-style: none; }
  .hit {
    display: flex; flex-direction: column; gap: 1rem; height: 100%;
    padding: 1.1rem 1.1rem 1.1rem; border-radius: 18px;
    background: var(--surface); color: var(--text); text-decoration: none;
    transition: transform .35s ease, box-shadow .35s ease;
  }
  .hit:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgb(38 48 127 / 0.08); }
  .text { display: flex; flex-direction: column; gap: 0.25rem; max-width: 30rem; }
  .title { font-family: var(--font-head); font-size: 1.3rem; line-height: 1.25; }
  .hit:hover .title { color: var(--accent); }
  .ext { font-family: var(--font-text); font-size: 0.9rem; color: var(--muted); }
  .short { font-size: 0.92rem; color: var(--muted); line-height: 1.5; }
  .wip { font-size: 0.8rem; color: var(--accent); }
  .media {
    position: relative; flex: 1; min-height: 12rem; display: block; overflow: hidden;
    border-radius: 12px; background: var(--bg);
  }
  .media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .6s ease; }
  .hit:hover .media img { transform: scale(1.02); }
  .media :global(.ph) { height: 100%; aspect-ratio: auto !important; border-radius: 12px; }
  .tall .media { min-height: 22rem; }
</style>
