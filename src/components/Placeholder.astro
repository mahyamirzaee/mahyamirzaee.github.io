---
// A clearly visible box for a missing image.
// Usage: <Placeholder label="add photo of woven textile" />
interface Props { label: string; ratio?: string; }
const { label, ratio = '16 / 10' } = Astro.props;
---
<div class="ph" style={`aspect-ratio:${ratio}`} role="img" aria-label={`Placeholder: ${label}`}>
  <span>[TODO: {label}]</span>
</div>
<style>
  .ph {
    display: grid; place-items: center; width: 100%; padding: 1rem; text-align: center;
    background-color: var(--surface);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 14px 14px;
    border: 1px dashed var(--thread);
  }
  span { background: var(--bg); padding: 0.3rem 0.7rem; font-size: 0.85rem; color: var(--accent); font-family: ui-monospace, monospace; }
</style>
